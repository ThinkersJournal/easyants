---
import type { Card } from '../lib/load';
interface Props { card: Extract<Card, { status: 'released' }> }
const { card } = Astro.props;
const { example } = card;
const caption = `${example.excerpt ? 'Excerpt from ' : 'From '}${example.source}`;
---
<li>
  <details class="card" id={card.slug}>
    <summary>
      <span class="card-name">{card.name}</span>
      <span class="card-sentence">{card.sentence}</span>
    </summary>
    <div class="card-body">
      <pre tabindex="0" aria-label={`${card.name} example`}><code class={`language-${example.lang}`}>{example.code}</code></pre>
      <p class="src">{caption}</p>
      {card.installSnippet && <p class="snippet"><code>{card.installSnippet}</code></p>}
      <p class="links">
        <a href={card.installUrl}>Install {card.name}</a>
        <a href={card.docs}>{card.name} project page</a>
      </p>
    </div>
  </details>
</li>
